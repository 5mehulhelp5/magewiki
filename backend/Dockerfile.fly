# Production image for the Fly deployment -- the existing Dockerfile stays
# untouched for local docker-compose dev (bind-mounted source, `--reload`).
# This one skips the dev dependency group (pytest/ruff/mypy, never needed
# at runtime, only bloat+attack surface in a deployed image), builds in a
# separate stage (mirrors frontend/Dockerfile.fly's own builder/runner
# split: poetry itself, pip's cache, and the resolver's work only exist to
# put .venv together, so they never need to ship in the final image), and
# drops to a non-root user.
FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1

RUN pip install "poetry==1.8.3"

WORKDIR /app

COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root --without dev

# litellm pins filelock<4.0, blocking poetry from resolving the fix for 13 real
# filelock CVEs (3.32.7 -> 4.2.1) — but litellm only imports filelock from its own
# CLI/proxy-client tooling (litellm/proxy/client/cli/commands/*.py), which this app
# never invokes (we only call litellm.acompletion/aembedding). Forcing the upgrade
# out-of-band of poetry's lock is safe in practice; revisit once litellm relaxes its
# own pin and this can go back through poetry update normally. Installed into the
# same in-project .venv poetry install just created above (not system site-packages),
# so it actually ships -- the runner stage below only ever copies that one directory.
RUN . .venv/bin/activate && pip install --no-cache-dir --no-deps "filelock>=4.0.9,<5"


FROM python:3.13-slim AS runner

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY . .

# Non-root: the deployed Fly image never needs root at runtime.
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
